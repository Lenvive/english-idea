{
  "name": "english-idea",
  "script": "npm",
  "args": "start",
  "env": {
    "NODE_ENV": "production",
    "PORT": 3000
  },
  "instances": 1,
  "exec_mode": "cluster",
  "watch": false,
  "ignore_watch": ["node_modules", ".next", "logs"],
  "log_file": "./logs/combined.log",
  "out_file": "./logs/out.log",
  "error_file": "./logs/error.log",
  "time": true
}
